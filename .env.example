# ==============================================================================
# SentinelPR Configuration Example
# Copy this file to .env and replace placeholders with real values for deployment.
# NEVER commit .env to version control.
# ==============================================================================

# Application & Environment
ENVIRONMENT=dev
LOG_LEVEL=INFO

# GitHub App Integration
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:sentinelpr/github-app-key-example
GITHUB_WEBHOOK_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:sentinelpr/webhook-secret-example
ALLOWED_REPO_IDS=123456789,987654321

# AWS Bedrock
BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
BEDROCK_REGION=us-east-1

# AWS DynamoDB & SQS
DYNAMODB_TABLE_NAME=sentinelpr-dev
SCAN_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/sentinelpr-scan-dev

# Security & Reporting Policy
MAX_INLINE_COMMENTS=25
FAIL_ON_HIGH_SECRETS=true
WARN_ONLY_MODE=false
SEMGREP_RULES_PATH=infrastructure/semgrep-rules
